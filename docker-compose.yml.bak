services:
  bot:
    build: .
    user: root
    restart: unless-stopped
    security_opt:
      - apparmor=unconfined
    env_file:
      - .env
    volumes:
      - ./data:/app/data
    init: true

  api:
    build: .
    user: root
    command: uvicorn web.api:app --host 0.0.0.0 --port 8000
    restart: unless-stopped
    security_opt:
      - apparmor=unconfined
    env_file:
      - .env
    ports:
      - "8000:8000"
    volumes:
      - ./data:/app/data
    init: true
