DISCORD_TOKEN=
DATABASE_PATH=data/helzerx.db
PREFIX=.
BOT_NAME=HelzerX Cloud
LOG_LEVEL=INFO
OWNER_IDS=
GUILD_ID=
REWARD_CHANNEL_ID=
LOG_CHANNEL_ID=

# Economy
DAILY_REWARD=100
MESSAGE_REWARD=2
MESSAGE_REWARD_COOLDOWN=60
VOICE_REWARD_PER_10_MIN=10
VOICE_MIN_MEMBERS=2

# Optional Proxmox integration
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE=
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Optional email/account integrations can be added later.

# Automatic VPS provisioning
PROXMOX_TEMPLATE_VMID=
PROXMOX_TEMPLATE_CTID=
PROXMOX_STORAGE=
PROXMOX_BRIDGE=vmbr0
PROXMOX_START=true
PROVISIONING_INTERVAL=20

# Pterodactyl Minecraft provisioning
PTERODACTYL_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_NEST_ID=
PTERODACTYL_EGG_ID=
PTERODACTYL_LOCATION_ID=
PTERODACTYL_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERODACTYL_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}} nogui
