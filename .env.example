DISCORD_TOKEN=
DATABASE_PATH=data/helzerx.db
PREFIX=.
BOT_NAME=HelzerX Cloud
LOG_LEVEL=INFO
OWNER_IDS=
GUILD_ID=
REWARD_CHANNEL_ID=
LOG_CHANNEL_ID=

# Economy
DAILY_REWARD=100
MESSAGE_REWARD=2
MESSAGE_REWARD_COOLDOWN=60
VOICE_REWARD_PER_10_MIN=10
VOICE_MIN_MEMBERS=2

# Optional Proxmox integration
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE=
PROXMOX_API_URL=
# Public Proxmox web URL users can open (usually https://host:8006)
PROXMOX_PUBLIC_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Optional email/account integrations can be added later.

# Automatic VPS provisioning (current VPS provider: LXC)
# Use PROXMOX_TEMPLATE_CTID for the prepared LXC template; leave TEMPLATE_VMID empty unless QEMU is explicitly enabled.
PROXMOX_TEMPLATE_VMID=
PROXMOX_TEMPLATE_CTID=
PROXMOX_STORAGE=
PROXMOX_BRIDGE=vmbr0
PROXMOX_START=true
# LXC password changes require host-side pct exec; SSH is used only for that operation.
PROXMOX_SSH_HOST=
PROXMOX_SSH_PORT=22
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY_FILE=
PROXMOX_SSH_PASSWORD=
PROXMOX_SSH_KNOWN_HOSTS=
PROXMOX_SSH_STRICT_HOST_KEY=true
# Optional multi-cluster JSON. Keys are cluster names used by provisioning metadata.
# Example: {"singapore":{"api_url":"https://pve.example.com","token_id":"user@pam!bot","token_secret":"...","verify_ssl":false}}
PROXMOX_CLUSTERS_JSON=
PROVISIONING_INTERVAL=20

# Pterodactyl Minecraft provisioning
PTERODACTYL_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_NEST_ID=
PTERODACTYL_EGG_ID=
PTERODACTYL_LOCATION_ID=
PTERODACTYL_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERODACTYL_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}} nogui

# Optional web API / email verification
WEB_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com
